{
  "manifest_version": 2,
  "name": "Joydash",
  "version": "1.10.27",
  "description": "Firefox home page for bookmarks, history, and video/page previews. Approved sites receive requested URLs and your IP; no data goes to the developer.",
  "icons": {
    "16": "icons/homeboard-16.png",
    "32": "icons/homeboard-32.png",
    "48": "icons/homeboard-48.png",
    "96": "icons/homeboard-96.png"
  },
  "permissions": ["storage", "bookmarks", "history"],
  "optional_permissions": ["<all_urls>"],
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quiet-start@example.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["bookmarksInfo", "browsingActivity", "websiteContent"]
      }
    }
  }
}
